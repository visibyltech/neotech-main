# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 Storage (Optional for live R2 buckets, built-in fallback provided)
CLOUDFLARE_R2_ACCOUNT_ID="your_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="neotech-gadget-media"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://media.neotechgadget.com"

# Credably BNPL Integration
CREDABLY_MERCHANT_ID="CRD_MCH_NEOTECH_001"
CREDABLY_PUBLIC_KEY="crd_pk_test_sample_key"
CREDABLY_SECRET_KEY="crd_sk_test_sample_secret"
CREDABLY_API_BASE_URL="https://api.credably.com/v1"
